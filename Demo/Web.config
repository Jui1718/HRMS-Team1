<configuration>
  <system.web>
	  <xhtmlConformance mode="Legacy" />
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
  </system.web>
  <connectionStrings>
    <add name="dbconn" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=Pulse360_FinalDb;Integrated Security=True;Encrypt=False;TrustServerCertificate=True;" providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>